<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:textColorPrimary">@color/app_text</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
</resources>
